QUERY:
----------------------------------------------------------------------
SELECT 
    account_holder
FROM 
    accounts
WHERE 
    account_id IN (
        SELECT 
            account_id
        FROM 
            transfer_logs
        WHERE 
            status = 'Unverified'
    );

